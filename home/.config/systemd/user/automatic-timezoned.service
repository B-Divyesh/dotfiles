[Unit]
Description=Automatically update system timezone based on location
Documentation=https://github.com/maxbrunet/automatic-timezoned
Wants=geoclue-agent.service
After=geoclue-agent.service

[Service]
ExecStart=/usr/bin/automatic-timezoned
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
