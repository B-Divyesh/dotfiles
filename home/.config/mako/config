# mako 1.11 — notifications (Ember)
# Super + N dismiss all · Super + Shift + N bring back · Super + Ctrl + N do-not-disturb
# left-click = open/act · right-click = dismiss · middle-click = pick an action

max-history=30
sort=-time
layer=overlay
anchor=top-right
outer-margin=6,10
margin=6
padding=12,16
width=360
height=160
max-visible=4

font=Inter 11
background-color=#1a141bee
text-color=#f0e4d4
border-color=#e89b5e
border-size=2
border-radius=12
progress-color=over #e89b5e55

icons=1
max-icon-size=48
icon-location=left
default-timeout=5000
ignore-timeout=0
markup=1
format=<b>%s</b>\n%b

on-button-left=invoke-default-action
on-button-middle=exec makoctl menu -n "$id" -- fuzzel --dmenu --prompt 'Action: '
on-button-right=dismiss

[urgency=low]
border-color=#4a3638

[urgency=critical]
border-color=#e5534b
default-timeout=0

[app-name=Screenshot]
max-icon-size=96

# AirPods (LibrePods): connected card + low-battery alerts
[app-name=LibrePods]
border-color=#8cb3d9
max-icon-size=64
width=380
default-timeout=4000

[app-name=LibrePods urgency=critical]
border-color=#e5534b
default-timeout=0

# volume / brightness / toggles: small centred popup with a progress bar
[app-name=osd]
anchor=bottom-center
outer-margin=0,0,90,0
width=240
padding=10,16
border-size=1
border-color=#4a3638
text-alignment=center
default-timeout=1200
history=0
format=<b>%s</b>
progress-color=over #e89b5e

[mode=do-not-disturb]
invisible=1

[mode=do-not-disturb app-name=osd]
invisible=0

[mode=do-not-disturb urgency=critical]
invisible=0
